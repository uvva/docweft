{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "textfabric",
  "version": "0.1.0",
  "description": "Cross-platform C++20 library for DOCX template manipulation",
  "homepage": "https://github.com/yourusername/TextFabric",
  "license": "MIT",
  "supports": "!(uwp | arm)",
  "dependencies": [
    {
      "name": "pugixml",
      "version>=": "1.14"
    },
    {
      "name": "libzip",
      "version>=": "1.10.1",
      "features": ["openssl"]
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.11.3"
    },
    {
      "name": "fmt",
      "version>=": "10.2.1"
    },
    {
      "name": "inja",
      "version>=": "3.4.0"
    },
    {
      "name": "stb",
      "version>=": "2024-07-29#1"
    },
    {
      "name": "tiff",
      "version>=": "4.6.0",
      "default-features": false
    },
    {
      "name": "podofo",
      "version>=": "1.0.0",
      "default-features": false
    },
    {
      "name": "catch2",
      "version>=": "3.5.3",
      "default-features": false
    }
  ],
  "overrides": [],
  "builtin-baseline": "c2a21b787cc505d5960d0292d30fd14306b07dd4"
}
